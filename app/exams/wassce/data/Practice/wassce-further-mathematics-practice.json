          "id": 9,
          "question": "Find the inverse of B = [2 1; 3 2]",
          "type": "matrix-inverse",
          "answer": "[2 -1; -3 2]",
          "workingSteps": [
            "det(B) = (2)(2) - (1)(3) = 4 - 3 = 1",
            "B⁻¹ = (1/det(B)) × [d -b; -c a]",
            "= (1/1) × [2 -1; -3 2] = [2 -1; -3 2]"
          ],
          "explanation": "Use the formula for 2×2 matrix inverse."
        }
