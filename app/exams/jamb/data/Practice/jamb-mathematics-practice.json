          "question": "Find the simple interest on ₦5000 for 3 years at 4% per annum",
          "options": ["₦600", "₦500", "₦400", "₦300"],
          "correctAnswer": 0,
          "explanation": "SI = PRT/100 = (5000 × 4 × 3)/100 = ₦600",
          "workingSteps": [
            "Step 1: SI = PRT/100",
            "Step 2: P = ₦5000, R = 4%, T = 3 years",
            "Step 3: SI = (5000 × 4 × 3)/100",
            "Step 4: SI = 60000/100 = ₦600"
          ]
        }
