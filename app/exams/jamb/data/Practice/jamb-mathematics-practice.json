          "topic": "Number Bases",
          "question": "Convert 101₂ to base 10",
          "options": ["4", "5", "6", "7"],
          "correctAnswer": 1,
          "explanation": "101₂ = 1×2² + 0×2¹ + 1×2⁰ = 4 + 0 + 1 = 5",
          "workingSteps": [
            "Step 1: Identify place values in base 2",
            "Step 2: 101₂ = 1×2² + 0×2¹ + 1×2⁰",
            "Step 3: = 1×4 + 0×2 + 1×1",
            "Step 4: = 4 + 0 + 1 = 5"
          ]
        },
        {
          "id": 2,
          "topic": "Fractions",
          "question": "Simplify: 2¾ ÷ 1⅛",
          "options": ["2⅖", "2½", "2⅔", "2¾"],
          "correctAnswer": 0,
          "explanation": "Convert to improper fractions: 11/4 ÷ 9/8 = 11/4 × 8/9 = 88/36 = 22/9 = 2⅖",
          "workingSteps": [
            "Step 1: Convert mixed numbers to improper fractions",
            "Step 2: 2¾ = 11/4, 1⅛ = 9/8",
            "Step 3: 11/4 ÷ 9/8 = 11/4 × 8/9",
            "Step 4: = (11×8)/(4×9) = 88/36 = 22/9 = 2⅖"
          ]
        },
        {
          "id": 3,
          "topic": "Percentages",
          "question": "If 25% of a number is 60, what is 40% of the same number?",
          "options": ["96", "100", "120", "150"],
          "correctAnswer": 0,
          "explanation": "If 25% = 60, then 100% = 240. Therefore 40% = 96",
          "workingSteps": [
            "Step 1: Let the number be x",
            "Step 2: 25% of x = 60, so 0.25x = 60",
            "Step 3: x = 60/0.25 = 240",
            "Step 4: 40% of 240 = 0.4 × 240 = 96"
          ]
        },
