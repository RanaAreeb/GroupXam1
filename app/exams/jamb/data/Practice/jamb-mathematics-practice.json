          "question": "If x : y = 3 : 4 and y : z = 2 : 5, find x : y : z",
          "options": ["3:4:10", "6:8:20", "3:4:5", "6:8:10"],
          "correctAnswer": 0,
          "explanation": "Make y equal in both ratios: x:y = 3:4, y:z = 4:10, so x:y:z = 3:4:10",
          "workingSteps": [
            "Step 1: x : y = 3 : 4",
            "Step 2: y : z = 2 : 5 = 4 : 10 (multiply by 2)",
            "Step 3: Now y = 4 in both ratios",
            "Step 4: x : y : z = 3 : 4 : 10"
          ]
        },
